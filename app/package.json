{
  "name": "shift-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "build:worker": "esbuild worker/main.ts --bundle --platform=node --target=node22 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=dist-worker/main.cjs",
    "worker": "npm run build:worker && node dist-worker/main.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
