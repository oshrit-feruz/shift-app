# ── Client (public by design, shipped in the browser bundle) ─────────────
# Copy to .env.local and fill in from your project's dashboard
# (Settings → API). Both values are public: the anon key is meant to ship
# in the client, and Row-Level Security is the actual boundary.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Flip to true once the Apple provider is configured in the Supabase
# dashboard (Services ID + secret). This is the entire enable path for the
# Apple button — no code change needed. See supabase/README.md.
VITE_APPLE_AUTH_ENABLED=false

# ── Server only (NEVER prefix these with VITE_) ──────────────────────────
# A VITE_ prefix would inline the value into the client bundle, handing
# every visitor a key that bypasses Row-Level Security entirely.
# Used by api/delete-account.ts to delete the calling user's account.
# SUPABASE_URL is optional — it falls back to VITE_SUPABASE_URL above.
# Find the service-role key at Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# REQUIRED for live prices. Used by /api/quote (the last price and day change
# on every screen) and /api/candles (the charts). Get one free at
# https://finnhub.io — the free key serves quotes; historical candles are on
# the paid tiers, so with a free key the charts report that the plan does not
# cover them and everything else works.
#
# On Vercel: Project Settings -> Environment Variables, name it exactly as
# below, for Production, Preview and Development, then redeploy. Locally: put
# it in app/.env.local, which is git-ignored.
FINNHUB_API_KEY=<finnhub-api-key>

# Optional. Translates /api/news headlines and excerpts to Hebrew when the app
# is running in Hebrew (api/_lib/translate.ts). Without it the news is served
# in the provider's English — the route degrades, it does not fail.
# A Google Cloud API key with the Cloud Translation API enabled. It is sent as
# that API's `key=` query parameter, so restrict the key BY API (Cloud
# Translation) rather than by HTTP referrer, which a server-side call has none
# of. First 500k characters a month are free; billing must still be enabled.
GOOGLE_TRANSLATE_API_KEY=<google-cloud-api-key>

# Optional — connected brokerage accounts (SnapTrade). Without these the
# connect button reports "not configured" and nothing else in the app changes.
# Get the pair from https://snaptrade.com; the free Starter plan allows five
# connected accounts.
SNAPTRADE_CLIENT_ID=<snaptrade-client-id>
SNAPTRADE_CONSUMER_KEY=<snaptrade-consumer-key>
# 32 bytes of base64 — `openssl rand -base64 32` — that encrypt each user's
# stored SnapTrade secret (api/_lib/secretBox.ts). Generate it once and keep
# it: change or lose it and every existing connection becomes unreadable, and
# those users must disconnect and connect again.
SNAPTRADE_SECRET_KEY=<base64-32-bytes>
# Optional. Where SnapTrade's Connection Portal returns the user when they are
# done. Defaults to the host the request arrived at, which is right for
# preview deploys; set it if the app is served from a different origin.
SNAPTRADE_REDIRECT_URL=
