# ── Client (public by design, shipped in the browser bundle) ─────────────
# Copy to .env.local and fill in from your project's dashboard
# (Settings → API). Both values are public: the anon key is meant to ship
# in the client, and Row-Level Security is the actual boundary.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Flip to true once the Apple provider is configured in the Supabase
# dashboard (Services ID + secret). This is the entire enable path for the
# Apple button — no code change needed. See supabase/README.md.
VITE_APPLE_AUTH_ENABLED=false

# ── Server only (NEVER prefix these with VITE_) ──────────────────────────
# A VITE_ prefix would inline the value into the client bundle, handing
# every visitor a key that bypasses Row-Level Security entirely.
# Used by api/delete-account.ts to delete the calling user's account.
# SUPABASE_URL is optional — it falls back to VITE_SUPABASE_URL above.
# Find the service-role key at Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional. Translates /api/news headlines and excerpts to Hebrew when the app
# is running in Hebrew (api/_lib/translate.ts). Without it the news is served
# in the provider's English — the route degrades, it does not fail. Get a free
# key at https://www.deepl.com/pro-api (free keys end in ":fx", which is how
# the route knows to use DeepL's free host).
DEEPL_API_KEY=<deepl-key>
