# Live price feed (Alpaca IEX WebSocket) — see src/data/alpacaLive.ts.
#
# Get a free key pair at https://app.alpaca.markets (sign up, then Paper
# Trading -> API Keys). These are read from the browser bundle, so:
#
#   ⚠️  USE PAPER-TRADING KEYS ONLY. NEVER a live-account key pair.
#
# The keys are visible to anyone who opens devtools on the deployed app —
# there is no server in this loop to hide them behind (see the file above
# for why). A leaked paper key can only read market data and place fake
# paper orders; there is no real money or real order routing behind it.
#
# Leaving these unset does not break the app: price-alert crossing detection
# just stays inactive and the alert sheet shows "live.unconfigured".
VITE_ALPACA_KEY_ID=
VITE_ALPACA_SECRET_KEY=
