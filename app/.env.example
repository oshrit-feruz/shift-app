# Supabase — copy to .env.local and fill in from your project's dashboard
# (Settings → API). Both values are public by design: the anon key is meant
# to ship in the client, and Row-Level Security is the actual boundary.
# Secrets (service-role key etc.) must NEVER appear here or in any VITE_ var —
# see the convention note in api/news.ts.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Flip to true once the Apple provider is configured in the Supabase
# dashboard (Services ID + secret). This is the entire enable path for the
# Apple button — no code change needed. See supabase/README.md.
VITE_APPLE_AUTH_ENABLED=false
